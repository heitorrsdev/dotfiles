Set-Location C:\back\
fnm env --use-on-cd | Out-String | Invoke-Expression

# ================================
# PROMPT
# ================================

function Get-GitBranch {
    $branch = git symbolic-ref --quiet --short HEAD 2>$null

    if ($LASTEXITCODE -ne 0 -or [string]::IsNullOrWhiteSpace($branch)) {
        return ""
    }

    return " ($($PSStyle.Foreground.Cyan)$branch$($PSStyle.Reset))"
}

function Get-DirectoryDisplay {
    git rev-parse --is-inside-work-tree 2>$null | Out-Null

    if ($LASTEXITCODE -eq 0) {
        # Dentro de repo -> mostra só a pasta atual
        $directory = Split-Path -Leaf (Get-Location)
    }
    else {
        # Fora de repo -> mostra caminho normal, substituindo HOME por ~
        $directory = (Get-Location).Path

        if ($directory.StartsWith($HOME)) {
            $directory = "~" + $directory.Substring($HOME.Length)
        }
    }

    return "$($PSStyle.Foreground.Blue)$directory$($PSStyle.Reset)"
}

function prompt {
    $user = $env:USERNAME.ToLower()
    $machine = $env:COMPUTERNAME

    $identity = "$($PSStyle.Foreground.Green)$user@$machine$($PSStyle.Reset)"
    $directory = Get-DirectoryDisplay
    $branch = Get-GitBranch

    return "$identity`:$directory$branch`n$ "
}
